# ================================
# Hub RRD — Variáveis de Ambiente
# ================================
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite .env ou .env.local no repositório.

# ── PostgreSQL isolado do Hub RRD (obrigatório em produção) ──
POSTGRES_RRD_URL=
# DATABASE_URL=  # alternativa ao POSTGRES_RRD_URL

# ── Segredo compartilhado entre Sofia/HubVibeDoCode e Hub RRD (obrigatório) ──
# Usado como Bearer token no endpoint /api/sofia/dispatch e /api/v1/health.
# Gere com: openssl rand -hex 32
SOFIA_HUB_SECRET=

# ── Senha inicial do operador Rafael (usada pelo seed) ──
# Executar: npm run db:seed após definir.
INITIAL_RAFAEL_PASSWORD=

# ── Senha de acesso ao portal (fallback para login quando DB tem user sem hash) ──
PORTAL_PASSWORD=
