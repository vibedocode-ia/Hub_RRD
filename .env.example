# Variáveis de ambiente — RR Desentupidora Site + Hub RRD
# Copie este arquivo para .env.local e preencha os valores

# Senha de acesso ao Hub RRD (PortalGate)
# Usada em NEXT_PUBLIC porque o atual gate é client-side (MVP visual)
# Na versão final do Hub, migrar para Server Action e remover NEXT_PUBLIC_
NEXT_PUBLIC_DEMO_HUB_PASS=sua_senha_aqui

# (futuro) Senha via Server Action — NÃO exposta ao cliente
# PORTAL_PASSWORD=sua_senha_segura_aqui
